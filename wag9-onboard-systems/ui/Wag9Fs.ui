  <property name="styleSheet">
   <string notr="true">QPushButton {
 border: none;
 background: transparent;
}
#hintsButton {
 color: #1c8fd4;
 background: white;
 border: 2px solid #1c8fd4;
 border-radius: 4px;
 font: bold 13px &quot;Arial&quot;;
}
#hintsButton:checked {
 color: white;
 background: #1c8fd4;
}
#pneumoCcb, #pneumoE70 {
 color: #1c8fd4;
 background: white;
 border: 2px solid #1c8fd4;
 border-radius: 4px;
 font: bold 13px "Arial";
}
#pneumoCcb:checked, #pneumoE70:checked {
 color: white;
 background: #1c8fd4;
}
#pneumoCcb:disabled, #pneumoE70:disabled {
 color: #9bbfd6;
 border-color: #9bbfd6;
}
#pneumoCcb:checked:disabled, #pneumoE70:checked:disabled {
 color: white;
 background: #9bbfd6;
}
#frameView {
 background-color: rgba(0, 0, 0, 140);
 border-image: none;
}</string>
