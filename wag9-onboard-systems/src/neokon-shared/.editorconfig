# VisualStudio 2017 supports .editorconfig files natively.
# For earlier versions, install a plugin from http://editorconfig.org

root = true

[*]
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{cpp,h,proto,cmake}]
indent_style = space
indent_size = 4
guidelines = 100
